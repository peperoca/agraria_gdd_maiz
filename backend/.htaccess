# Corn GDD Tracker API - Security & CORS

# Block direct access to sensitive files
<FilesMatch "^(config|db|helpers)\.php$">
    Require all denied
</FilesMatch>

# Block access to cron directory via web
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^cron/ - [F,L]
    RewriteRule ^sql/ - [F,L]
</IfModule>

# Force HTTPS (uncomment if SSL is available)
